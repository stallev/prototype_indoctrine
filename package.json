    "migrate:content": "tsx scripts/migrate-json-to-ts.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
