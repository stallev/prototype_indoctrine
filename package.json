    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-sdk/xai": "^4.0.42",
    "ai": "^7.0.73",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
