{
  "name": "prototype-indoctrine",
  "version": "0.1.0",
  "private": true,
  "description": "Статический HTML-прототип катехизиса",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/app.css",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./styles/app.css --watch",
    "serve": "npx --yes serve .",
    "migrate:content": "tsx scripts/migrate-json-to-ts.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4",
    "@types/node": "^26.2.0",
    "tailwindcss": "4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
