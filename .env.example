# Ключ Google AI (Gemini) для инструмента генерации изображений.
# См. docs/contracts/image-generator-api-contract.md §4 и docs/specs/image-generator-tool-spec.md §3.
# Читается только в app/api/image-generator/route.ts (сервер), никогда не попадает в клиентский бандл.
GEMINI_API_KEY=

# Ключ доступа к UI/API инструмента генерации изображений (не GEMINI_API_KEY,
# не для Google — это отдельный секрет, ограничивающий, кто вообще может
# пользоваться инструментом). Проверяется Server Action'ом
# (app/tools/image-generator/actions.ts) и Route Handler'ом
# (app/api/image-generator/route.ts) через lib/image-generator-auth.ts.
# См. docs/specs/image-generator-tool-spec.md §6.
SECURITY_IMAGE_GENERATOR_KEY=
