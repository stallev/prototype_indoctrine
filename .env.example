# Ключ xAI (Grok Imagine) для инструмента генерации изображений.
# См. docs/contracts/image-generator-api-contract.md §4 и docs/specs/image-generator-tool-spec.md §3.
# Читается только в lib/image-generator-generate.ts (сервер), никогда не попадает в клиентский бандл.
# Не XAI_API_KEY (имя по умолчанию у @ai-sdk/xai) — провайдер создаётся явно
# через createXai({ apiKey: process.env.GROK_API_KEY }).
GROK_API_KEY=

# Ключ доступа к UI/API инструмента генерации изображений (не GROK_API_KEY —
# это отдельный секрет, ограничивающий, кто вообще может пользоваться
# инструментом). Проверяется Server Action'ом
# (app/tools/image-generator/actions.ts) и Route Handler'ом
# (app/api/image-generator/route.ts) через lib/image-generator-auth.ts.
# См. docs/specs/image-generator-tool-spec.md §6.
SECURITY_IMAGE_GENERATOR_KEY=
